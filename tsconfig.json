{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "google.maps"],

    // Audit 2026-09-09 (I2) : sans `strict`, « 0 erreur TypeScript » ne garantissait
    // presque rien (1 692 `: any`, aucun contrôle de null). Les 56 erreurs
    // révélées par le mode strict ont été corrigées — dont 8 vrais risques
    // d'écran blanc (déréférencement de null). Ne pas désactiver.
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true
  },

  // Sans `exclude`, tsc ratisse TOUT le dossier depuis la racine. Deux dégâts :
  //
  //  1. `mobile/` (l'app Expo, non suivie sur main — elle vit sur la branche
  //     `mobile-app`). expo-modules-core y déclare NODE_ENV comme membre
  //     OBLIGATOIRE de NodeJS.ProcessEnv dans un `declare global`, et la fusion
  //     de déclarations la rend contagieuse : `npm run lint` remontait alors
  //     60 erreurs dans tests/ et server/ — du code sain — pendant que la CI
  //     restait verte, puisqu'elle ne voit jamais ce dossier. Un lint qui ment
  //     en local ne sert plus à rien : on cesse de le croire.
  //  2. `dist/` après un `npm run build` : avec `allowJs: true`, le bundle
  //     minifié devient de l'entrée de compilation.
  //
  // `node_modules` est redéclaré parce qu'un `exclude` explicite REMPLACE les
  // exclusions par défaut de tsc, il ne s'y ajoute pas.
  "exclude": ["node_modules", "dist", "mobile"]
}
