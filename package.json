    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:apply": "tsx scripts/apply-sql.ts",
    "db:apply:prod": "tsx scripts/apply-sql.ts --prod",
    "db:bootstrap": "tsx scripts/apply-sql.ts supabase/baseline/01_schema.sql supabase/baseline/02_post_schema.sql",
