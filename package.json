    "qa:inscription": "node --env-file=.env.local scripts/qa/verifier-inscription.mjs",
    "qa:paywall": "node --env-file=.env.local scripts/qa/verifier-paywall.mjs",
    "qa:tout": "node scripts/qa/tout.mjs",
    "qa:rapport": "node scripts/qa/rapport.mjs",
    "qa:campagne": "node scripts/qa/campagne.mjs",
    "qa:boutons": "node --env-file=.env.local scripts/qa/boutons.mjs",
    "qa:carte": "node scripts/qa/carte.mjs",
