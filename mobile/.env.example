# ── Supabase (REQUIRED) ─────────────────────────────────────────
# Same project as the web app. Use the PUBLIC anon key only — never
# put the service-role key in a mobile build (it gets bundled into the
# JS and shipped to every user's device).
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# ── Web app URL (OPTIONAL) ──────────────────────────────────────
# Origin of your deployed Lume web app. Used to build client payment
# links: {EXPO_PUBLIC_WEB_URL}/pay/:token. Leave unset to disable the
# "Send payment link" button.
EXPO_PUBLIC_WEB_URL="https://your-lume-web-app.com"

# ── Mapbox (REQUIRED for the D2D / field-sales map) ─────────────
# Public Mapbox token (pk.…). Powers the door-to-door map (D2DWebMap,
# Mapbox GL JS in a WebView). Without it the map renders blank.
EXPO_PUBLIC_MAPBOX_TOKEN="pk.your-mapbox-public-token"
