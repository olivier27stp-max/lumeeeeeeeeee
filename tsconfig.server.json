{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "jsx": "preserve",
    "allowImportingTsExtensions": false,
    "noEmit": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["node_modules", "dist", "src", "tests"]
}
